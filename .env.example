# Copier en `.env`. Le fichier `.env` n'est jamais commite (voir .gitignore).

# --- Fournisseur LLM --------------------------------------------------------
# Choisi par --provider=<nom>, ou par defaut ici.
#   mock       hors ligne, aucun appel (defaut)
#   groq | gemini | mistral | openrouter    palier GRATUIT, clef requise
#   ollama | lmstudio                       local, aucune clef
#   anthropic  payant
# `npm run dev -- --providers` liste l'etat de chacun.
MEDIA_PROVIDER=mock

# Surcharge le modele du fournisseur choisi. Laisser vide pour son defaut.
MEDIA_MODEL=

# --- Clefs des fournisseurs gratuits ----------------------------------------
# Une seule suffit. Toutes s'obtiennent sans carte bancaire.

# https://console.groq.com/keys — rapide, modeles 70B
GROQ_API_KEY=

# https://aistudio.google.com/apikey — bon suivi de schema JSON
GEMINI_API_KEY=

# https://console.mistral.ai/api-keys — modeles francophones
MISTRAL_API_KEY=

# https://openrouter.ai/keys — agrege plusieurs modeles gratuits
OPENROUTER_API_KEY=

# https://ollama.com/settings/keys — service HEBERGE (--provider=ollama-cloud),
# a ne pas confondre avec --provider=ollama, qui est le serveur local.
# Le palier gratuit ne couvre que gpt-oss:20b/120b, gemma4:31b et
# nemotron-3-nano ; les gros modeles renvoient HTTP 402.
OLLAMA_API_KEY=

# --- Anthropic (payant) -----------------------------------------------------
# Facturation SEPAREE d'un abonnement Pro/Max, qui ne couvre pas l'API.
# Seul mode exercant src/llm/anthropic-client.ts.
ANTHROPIC_API_KEY=

# --- Sources externes -------------------------------------------------------
# La plupart des sources branchees (Banque mondiale, FMI, Eurostat, USGS) ne
# demandent aucune clef. Celles ci-dessous en exigent une ; sans elles, la
# source est simplement declaree absente au lieu d'echouer a chaque appel.

# FRED (Fed de St. Louis) — clef gratuite :
# https://fredaccount.stlouisfed.org/apikeys
# ATTENTION : FRED transporte sa clef DANS l'URL. Le journal d'audit la
# caviarde automatiquement (src/audit/redaction.ts), mais ne la colle jamais
# dans une commande shell : elle resterait dans l'historique du terminal.
FRED_API_KEY=

# Currents — clef gratuite : https://currentsapi.services/
# Envoyee en en-tete `Authorization: Bearer`, PAS dans l'URL : le parametre
# `apiKey` documente par le fournisseur la ferait fuiter dans chaque journal.
CURRENTS_API_KEY=

# NewsData — clef gratuite : https://newsdata.io/
# Envoyee en en-tete `X-ACCESS-KEY`, pour la meme raison.
NEWSDATA_API_KEY=

# CoinGecko — clef Demo gratuite : https://www.coingecko.com/en/developers/dashboard
# Envoyee en en-tete `x-cg-demo-api-key`. Le plan Demo impose l'attribution
# « selon CoinGecko », que le gate exige de toute facon.
# Ses conditions commerciales restent une decision de l'editeur.
COINGECKO_API_KEY=

# --- Reglages d'execution ---------------------------------------------------
# Adresse PUBLIQUE du site. Vide : https://jamess02.github.io/media-next-gen.
# Elle doit etre absolue : un flux RSS et un plan de site ne peuvent pas porter
# de chemins relatifs, un lecteur de flux ne sachant pas d'ou ils viennent.
MEDIA_SITE_URL=

# Duree du cache des donnees de marche, en minutes. Vide : chaque connecteur
# garde la sienne — sept jours pour une bougie Binance close, un jour pour
# CoinGecko, six heures pour Yahoo, qui ajuste ses series. Une valeur illisible
# n'est pas devinee : un cache de duree inventee est un cache dont on ignore
# l'etat.
MARCHE_CACHE_TTL_MINUTES=

# Racine du cache des flux RSS/Atom. Vide : .cache/sources, a la racine du
# depot. Un conteneur peut la pointer vers un volume qui survit au redemarrage.
#
# La suite de tests la surcharge d'office (vitest.config.ts) : sans cela, un
# test qui bouchonne le reseau deposait son faux flux dans le cache de
# production, ou le pipeline l'aurait servi pendant toute la duree du TTL.
SOURCES_CACHE_DIR=
